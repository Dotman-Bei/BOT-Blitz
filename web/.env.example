# BOT Chain network - values from the official docs, verified against the RPC by `npm run check-chain`
# https://dev-docs.bohr.life/docs/Developers/quick-guide/

# --- Mainnet (chain 677) ---------------------------------------------------------------------
NEXT_PUBLIC_BOT_CHAIN_ID=677
NEXT_PUBLIC_BOT_CHAIN_NAME=BOT Chain
NEXT_PUBLIC_BOT_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_BOT_EXPLORER_URL=https://scan.botchain.ai
NEXT_PUBLIC_BOT_CURRENCY_SYMBOL=BOT
# Mainnet BOT is only available via the official DEX (no faucet)
NEXT_PUBLIC_BOT_DEX_URL=https://dex.botchain.ai/#/swap
NEXT_PUBLIC_BOT_FAUCET_URL=
# Deployed BOTBlitz contract on mainnet
NEXT_PUBLIC_BLITZ_ADDRESS=

# --- Testnet (chain 968) - swap these in to run against testnet ------------------------------
